</footer>
<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: linear-gradient(to bottom, rgba(229, 233, 240, 0.5), #fff) no-repeat;
		color: rgb(96, 115, 159);
		text-align: center;
	}
</style>
