---
import "../styles/global.css";
import type { ImageMetadata } from "astro";
import FallbackImage from "../assets/hero-image-holder.jpg";
import { SITE_TITLE, SITE_AUTHOR } from "../consts";
import { siteLocale } from "../i18n/ui";
import { toShareImage } from "../lib/og-image";
import { ClientRouter } from "astro:transitions";

interface Props {
    title: string;
    description: string;
    image?: ImageMetadata;
    jsonLd?: Record<string, unknown> | Record<string, unknown>[];
    ogType?: "website" | "article"; // 文章頁傳 article，其餘維持 website
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
    title,
    description,
    image = FallbackImage,
    jsonLd,
    ogType = "website",
} = Astro.props;

// og:image 不能直接用 image.src（指向未優化原圖），統一走縮壓後的分享圖
const shareImageSrc = await toShareImage(image);
---

<!-- charset 必須落在 HTML 前 1024 bytes 內，故搶在所有 script（含 inline 主題判斷、
     ClientRouter）之前輸出，否則前面的腳本會把它擠出視窗、瀏覽器改用預設編碼。 -->
<meta charset="utf-8" />
<script is:inline>
    // 主題 class 的唯一來源：<html> 上永遠有 .dark 或 .light，
    // 「跟隨系統」也在這裡即時解析成其中之一。如此 CSS 只需維護
    // :root.dark 一份深色 token，不必再同步 @media 重複區塊。
    // （代價：關閉 JS 的使用者固定淺色。）
    const theme = localStorage.getItem("theme") ?? "system";
    const dark =
        theme === "dark" ||
        (theme === "system" &&
            window.matchMedia("(prefers-color-scheme: dark)").matches);
    document.documentElement.classList.add(dark ? "dark" : "light");
</script>
<script>
    // ClientRouter 換頁前把主題 class 寫入新 document，避免 View Transitions 截圖時閃爍
    document.addEventListener("astro:before-swap", (ev) => {
        const theme = localStorage.getItem("theme") ?? "system";
        const dark =
            theme === "dark" ||
            (theme === "system" &&
                window.matchMedia("(prefers-color-scheme: dark)").matches);
        const newDoc = (ev as unknown as { newDocument: Document }).newDocument;
        newDoc.documentElement.classList.remove("dark", "light");
        newDoc.documentElement.classList.add(dark ? "dark" : "light");
    });
</script>
<ClientRouter />
<!-- Global Metadata -->
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
    rel="alternate"
    type="application/rss+xml"
    title={SITE_TITLE}
    href={new URL("rss.xml", Astro.site)}
/>
<meta name="generator" content={Astro.generator} />
<meta name="author" content={SITE_AUTHOR} />

<!-- 폰트: Pretendard Variable (한글+라틴 조화, Inter 기반). -->
<link
    rel="stylesheet"
    as="style"
    crossorigin
    href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
/>


<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:locale" content={siteLocale.og} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(shareImageSrc, canonicalURL)} />

<!-- Twitter（X 規格是 name= 而非 property=；缺 twitter 標籤時 X 會 fallback 到 OG，
     但 summary_large_image 這種 twitter 專屬欄位沒有 OG 對應，得靠 name= 正確讀到） -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(shareImageSrc, canonicalURL)} />

<!-- JSON-LD 結構化資料（schema.org）：跳脫 `<` 避免字串內容提早關閉 script -->
{
    jsonLd && (
        <script
            type="application/ld+json"
            set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")}
        />
    )
}
