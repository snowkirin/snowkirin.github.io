---
import { GISCUS_CATEGORY, GISCUS_CATEGORY_ID, GISCUS_REPO, GISCUS_REPO_ID } from '../consts';

interface Props {
	term: string;
}

const { term } = Astro.props;

const enabled = Boolean(GISCUS_REPO_ID && GISCUS_CATEGORY_ID && GISCUS_REPO && GISCUS_CATEGORY);
---

{enabled && (
	<section class="mt-12 border-t border-neutral-200 pt-8">
		<h2 class="mb-4 text-xl font-bold">댓글</h2>
		<div id="giscus" data-term={term}></div>
	</section>
)}

<script>
	const repo = {
		repo: import.meta.env.PUBLIC_GISCUS_REPO ?? {GISCUS_REPO},
		repoId: import.meta.env.PUBLIC_GISCUS_REPO_ID ?? {GISCUS_REPO_ID},
		category: import.meta.env.PUBLIC_GISCUS_CATEGORY ?? {GISCUS_CATEGORY},
		categoryId: import.meta.env.PUBLIC_GISCUS_CATEGORY_ID ?? {GISCUS_CATEGORY_ID},
	};

	if (repo.repo && repo.repoId && repo.category && repo.categoryId) {
		const script = document.createElement('script');
		script.src = 'https://giscus.app/client.js';
		script.async = true;
		script.setAttribute('data-repo', repo.repo);
		script.setAttribute('data-repo-id', repo.repoId);
		script.setAttribute('data-category', repo.category);
		script.setAttribute('data-category-id', repo.categoryId);
		script.setAttribute('data-mapping', 'specific');
		script.setAttribute('data-term', document.getElementById('giscus')?.dataset.term ?? '');
		script.setAttribute('data-reactions-enabled', '1');
		script.setAttribute('data-emit-metadata', '0');
		script.setAttribute('data-theme', 'preferred_color_scheme');
		script.setAttribute('data-lang', 'ko');
		script.setAttribute('crossorigin', 'anonymous');
		const container = document.getElementById('giscus');
		if (container) container.appendChild(script);
	}
</script>
