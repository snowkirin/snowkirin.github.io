---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = await getCollection('blog');
const tagCounts = new Map<string, number>();
for (const post of posts) {
	for (const tag of post.data.tags) {
		tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
	}
}
const tags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]);
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`태그 | ${SITE_TITLE}`} description="블로그 태그 목록" />
	</head>
	<body>
		<Header />
		<main class="!w-full max-w-3xl">
			<h1 class="text-3xl font-bold">태그</h1>
			<ul class="mt-8 flex list-none flex-wrap gap-3 p-0">
				{tags.map(([tag, count]) => (
					<li>
						<a
							href={`/tags/${tag}/`}
							class="inline-block rounded-full bg-neutral-100 px-4 py-1.5 text-sm text-neutral-700 hover:bg-neutral-200"
						>
							#{tag} <span class="text-neutral-400">({count})</span>
						</a>
					</li>
				))}
			</ul>
			{tags.length === 0 && <p class="text-neutral-500">등록된 태그가 없습니다.</p>}
		</main>
		<Footer />
	</body>
</html>
