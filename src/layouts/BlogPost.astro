---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Giscus from '../components/Giscus.astro';
import Header from '../components/Header.astro';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, tags, category, series } =
	post.data;

// 시리즈 내 다른 글 조회
let seriesPosts: CollectionEntry<'blog'>[] = [];
if (series) {
	seriesPosts = (await getCollection('blog'))
		.filter((p) => p.data.series?.name === series.name)
		.sort((a, b) => (a.data.series?.order ?? 0) - (b.data.series?.order ?? 0));
}

// 이전/다음 글
const allPosts = (await getCollection('blog')).sort(
	(a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf(),
);
const postIndex = allPosts.findIndex((p) => p.id === post.id);
const prevPost = postIndex > 0 ? allPosts[postIndex - 1] : undefined;
const nextPost =
	postIndex >= 0 && postIndex < allPosts.length - 1 ? allPosts[postIndex + 1] : undefined;
---

<html lang="ko">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />
		<main class="!w-full max-w-3xl">
			<article>
				{heroImage && (
					<div class="mb-6">
						<Image width={1020} height={510} src={heroImage} alt="" class="mx-auto" />
					</div>
				)}

				<header class="mb-6 border-b border-neutral-200 pb-6 text-center">
					<p class="text-sm text-neutral-500">
						<FormattedDate date={pubDate} />
						{updatedDate && (
							<span class="block italic">
								수정일 <FormattedDate date={updatedDate} />
							</span>
						)}
					</p>
					<h1 class="mt-2 text-3xl font-bold leading-tight">{title}</h1>
					<p class="mt-2 text-neutral-600">{description}</p>

					<div class="mt-4 flex flex-wrap items-center justify-center gap-2 text-sm">
						<a href={`/categories/${category}/`} class="rounded bg-neutral-100 px-2 py-0.5 text-neutral-700 hover:bg-neutral-200">
							📁 {category}
						</a>
						{tags.map((tag) => (
							<a
								href={`/tags/${tag}/`}
								class="rounded bg-neutral-100 px-2 py-0.5 text-neutral-700 hover:bg-neutral-200"
							>
								#{tag}
							</a>
						))}
					</div>
				</header>

				<div class="prose max-w-none">
					<slot />
				</div>
			</article>

			{/* 시리즈 내비게이션 */}
			{series && seriesPosts.length > 1 && (
				<nav class="mt-8 rounded-lg border border-neutral-200 p-4">
					<p class="mb-2 text-sm font-semibold">시리즈: {series.name}</p>
					<ol class="ml-4 list-decimal space-y-1 text-sm">
						{seriesPosts.map((p) => (
							<li class={p.id === post.id ? 'text-accent' : ''}>
								<a href={`/blog/${p.id}/`}>{p.data.title}</a>
							</li>
						))}
					</ol>
				</nav>
			)}

			{/* 이전/다음 글 */}
			<div class="mt-8 flex justify-between gap-4 text-sm">
				<div>
					{prevPost && (
						<a href={`/blog/${prevPost.id}/`} class="hover:text-accent">
							← {prevPost.data.title}
						</a>
					)}
				</div>
				<div class="text-right">
					{nextPost && (
						<a href={`/blog/${nextPost.id}/`} class="hover:text-accent">
							{nextPost.data.title} →
						</a>
					)}
				</div>
			</div>

			<Giscus term={post.id} />
		</main>
		<Footer />
	</body>
</html>
